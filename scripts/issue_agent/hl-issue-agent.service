[Unit]
Description=Poll owner-approved hl-pracitse GitHub issues
After=network-online.target

[Service]
Type=oneshot
Environment=PATH=/home/muise/.local/bin:/home/muise/.nvm/versions/node/v24.20.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /home/muise/.local/share/hl-pracitse-issue-agent/agent.py poll /home/muise/.local/share/hl-pracitse-issue-agent/config.json
UMask=0077
TimeoutStartSec=240
StandardOutput=journal
StandardError=journal
